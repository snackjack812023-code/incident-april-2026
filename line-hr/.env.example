# Postgres connection string (Neon / Supabase / local Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/linehr

# Random string, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Public https URL of this app — used for links inside LINE messages
APP_URL=https://your-app.vercel.app

# Messaging API channel (LINE Official Account)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login channel that owns the LIFF app (must be under the SAME provider as the Messaging API channel)
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# Local development only: sign in without LINE via ?as=<fake user id>. Ignored by production builds.
# ALLOW_DEV_LOGIN=true
